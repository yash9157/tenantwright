{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["namespace", "opensearch", "collector", "dataPrepper", "fluentBit", "prometheus"],
  "properties": {
    "namespace": { "type": "string", "minLength": 1 },
    "opensearch": {
      "type": "object",
      "required": ["host", "port", "existingSecret", "usernameKey", "passwordKey"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "collector": { "type": "object", "required": ["image", "replicas", "resources"] },
    "dataPrepper": { "type": "object", "required": ["image", "replicas", "resources"] },
    "fluentBit": { "type": "object", "required": ["image", "resources"] },
    "prometheus": {
      "type": "object",
      "required": ["enabled", "image", "ingress", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "ingress": {
          "type": "object",
          "required": ["enabled", "className", "host", "path", "clusterIssuer", "tlsSecretName", "authSecretName", "ingressNamespace"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string", "minLength": 1 },
            "host": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "pattern": "^/" },
            "clusterIssuer": { "type": "string", "minLength": 1 },
            "tlsSecretName": { "type": "string", "minLength": 1 },
            "authSecretName": { "type": "string", "minLength": 1 },
            "ingressNamespace": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
