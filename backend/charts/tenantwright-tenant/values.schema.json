{
    "$schema":  "https://json-schema.org/draft-07/schema#",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "image",
                     "replicaCount",
                     "rollout",
                     "terminationGracePeriodSeconds",
                     "service",
                     "serviceAccount",
                     "podSecurityContext",
                     "securityContext",
                     "resources",
                     "topologySpread",
                     "env",
                     "probes",
                     "autoscaling",
                     "networkPolicy",
                     "pdb",
                     "tests"
                 ],
    "properties":  {
                       "nameOverride":  {
                                            "type":  "string"
                                        },
                       "fullnameOverride":  {
                                                "type":  "string"
                                            },
                       "image":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "repository",
                                                      "tag",
                                                      "digest",
                                                      "pullPolicy"
                                                  ],
                                     "properties":  {
                                                        "repository":  {
                                                                           "type":  "string",
                                                                           "minLength":  1
                                                                       },
                                                        "tag":  {
                                                                    "type":  "string"
                                                                },
                                                        "digest":  {
                                                                       "type":  "string",
                                                                       "pattern":  "^sha256:[0-9a-f]{64}$"
                                                                   },
                                                        "pullPolicy":  {
                                                                           "enum":  [
                                                                                        "Always",
                                                                                        "IfNotPresent",
                                                                                        "Never"
                                                                                    ]
                                                                       }
                                                    }
                                 },
                       "imagePullSecrets":  {
                                                "type":  "array",
                                                "items":  {
                                                              "type":  "object"
                                                          }
                                            },
                       "replicaCount":  {
                                            "type":  "integer",
                                            "minimum":  1
                                        },
                       "rollout":  {
                                       "type":  "object",
                                       "additionalProperties":  false,
                                       "required":  [
                                                        "revisionHistoryLimit",
                                                        "progressDeadlineSeconds",
                                                        "minReadySeconds",
                                                        "maxUnavailable",
                                                        "maxSurge"
                                                    ],
                                       "properties":  {
                                                          "revisionHistoryLimit":  {
                                                                                       "type":  "integer",
                                                                                       "minimum":  1,
                                                                                       "maximum":  20
                                                                                   },
                                                          "progressDeadlineSeconds":  {
                                                                                          "type":  "integer",
                                                                                          "minimum":  60,
                                                                                          "maximum":  3600
                                                                                      },
                                                          "minReadySeconds":  {
                                                                                  "type":  "integer",
                                                                                  "minimum":  0,
                                                                                  "maximum":  300
                                                                              },
                                                          "maxUnavailable":  {
                                                                                 "type":  [
                                                                                              "integer",
                                                                                              "string"
                                                                                          ]
                                                                             },
                                                          "maxSurge":  {
                                                                           "type":  [
                                                                                        "integer",
                                                                                        "string"
                                                                                    ]
                                                                       }
                                                      }
                                   },
                       "terminationGracePeriodSeconds":  {
                                                             "type":  "integer",
                                                             "minimum":  30,
                                                             "maximum":  300
                                                         },
                       "service":  {
                                       "type":  "object",
                                       "additionalProperties":  true
                                   },
                       "ingress":  {
                                       "type":  "object",
                                       "additionalProperties":  true
                                   },
                       "serviceAccount":  {
                                              "type":  "object",
                                              "additionalProperties":  true
                                          },
                       "podAnnotations":  {
                                              "type":  "object",
                                              "additionalProperties":  true
                                          },
                       "podLabels":  {
                                         "type":  "object",
                                         "additionalProperties":  true
                                     },
                       "podSecurityContext":  {
                                                  "type":  "object",
                                                  "required":  [
                                                                   "runAsNonRoot",
                                                                   "seccompProfile"
                                                               ],
                                                  "properties":  {
                                                                     "runAsNonRoot":  {
                                                                                          "const":  true
                                                                                      },
                                                                     "seccompProfile":  {
                                                                                            "type":  "object",
                                                                                            "required":  [
                                                                                                             "type"
                                                                                                         ],
                                                                                            "properties":  {
                                                                                                               "type":  {
                                                                                                                            "const":  "RuntimeDefault"
                                                                                                                        }
                                                                                                           }
                                                                                        }
                                                                 }
                                              },
                       "securityContext":  {
                                               "type":  "object",
                                               "required":  [
                                                                "allowPrivilegeEscalation",
                                                                "capabilities",
                                                                "readOnlyRootFilesystem",
                                                                "runAsNonRoot"
                                                            ],
                                               "properties":  {
                                                                  "allowPrivilegeEscalation":  {
                                                                                                   "const":  false
                                                                                               },
                                                                  "capabilities":  {
                                                                                       "type":  "object"
                                                                                   },
                                                                  "readOnlyRootFilesystem":  {
                                                                                                 "const":  true
                                                                                             },
                                                                  "runAsNonRoot":  {
                                                                                       "const":  true
                                                                                   }
                                                              }
                                           },
                       "resources":  {
                                         "type":  "object",
                                         "additionalProperties":  true
                                     },
                       "nodeSelector":  {
                                            "type":  "object",
                                            "additionalProperties":  true
                                        },
                       "tolerations":  {
                                           "type":  "array",
                                           "items":  {
                                                         "type":  "object"
                                                     }
                                       },
                       "affinity":  {
                                        "type":  "object",
                                        "additionalProperties":  true
                                    },
                       "topologySpread":  {
                                              "type":  "object",
                                              "additionalProperties":  false,
                                              "required":  [
                                                               "enabled",
                                                               "maxSkew",
                                                               "topologyKey",
                                                               "whenUnsatisfiable"
                                                           ],
                                              "properties":  {
                                                                 "enabled":  {
                                                                                 "type":  "boolean"
                                                                             },
                                                                 "maxSkew":  {
                                                                                 "type":  "integer",
                                                                                 "minimum":  1
                                                                             },
                                                                 "topologyKey":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  1
                                                                                 },
                                                                 "whenUnsatisfiable":  {
                                                                                           "enum":  [
                                                                                                        "DoNotSchedule",
                                                                                                        "ScheduleAnyway"
                                                                                                    ]
                                                                                       }
                                                             }
                                          },
                       "env":  {
                                   "type":  "object",
                                   "additionalProperties":  {
                                                                "type":  [
                                                                             "string",
                                                                             "number",
                                                                             "boolean"
                                                                         ]
                                                            }
                               },
                       "messaging": { "type": "object", "properties": { "provider": { "type": "string", "enum": ["None", "MassTransit", "Wolverine"] } }, "additionalProperties": true },
                       "config":  {
                                      "type":  "object",
                                      "additionalProperties":  true
                                  },
                       "sharedDatabaseTargets": {
                           "description": "Shared databases of the dedicatable services, as targets only (never credentials), rendered to TenantDatabases:SharedTargets.",
                           "type": "object",
                           "propertyNames": { "enum": ["AuditLogs", "Notifications", "Permissions"] },
                           "additionalProperties": {
                               "type": "object",
                               "required": ["host", "database"],
                               "properties": {
                                   "host": { "type": "string", "minLength": 1 },
                                   "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                                   "database": { "type": "string", "minLength": 1 }
                               },
                               "additionalProperties": false
                           }
                       },
                       "secretEnv":  {
                                         "type":  "object",
                                         "additionalProperties":  true
                                     },
                       "secretRefs":  {
                                          "type":  "array",
                                          "items":  {
                                                        "type":  "object"
                                                    }
                                      },
                       "extraEnv":  {
                                        "type":  "array",
                                        "items":  {
                                                      "type":  "object"
                                                  }
                                    },
                       "probes":  {
                                      "type":  "object",
                                      "additionalProperties":  true
                                  },
                       "autoscaling":  {
                                           "type":  "object",
                                           "additionalProperties":  false,
                                           "required":  [
                                                            "enabled",
                                                            "minReplicas",
                                                            "maxReplicas",
                                                            "behavior"
                                                        ],
                                           "anyOf":  [
                                                         {
                                                             "required":  [
                                                                              "targetCPUUtilizationPercentage"
                                                                          ]
                                                         },
                                                         {
                                                             "required":  [
                                                                              "targetMemoryUtilizationPercentage"
                                                                          ]
                                                         }
                                                     ],
                                           "properties":  {
                                                              "enabled":  {
                                                                              "type":  "boolean"
                                                                          },
                                                              "minReplicas":  {
                                                                                  "type":  "integer",
                                                                                  "minimum":  1
                                                                              },
                                                              "maxReplicas":  {
                                                                                  "type":  "integer",
                                                                                  "minimum":  1
                                                                              },
                                                              "targetCPUUtilizationPercentage":  {
                                                                                                     "type":  "integer",
                                                                                                     "minimum":  1,
                                                                                                     "maximum":  100
                                                                                                 },
                                                              "targetMemoryUtilizationPercentage":  {
                                                                                                        "type":  "integer",
                                                                                                        "minimum":  1,
                                                                                                        "maximum":  100
                                                                                                    },
                                                              "behavior":  {
                                                                               "type":  "object",
                                                                               "additionalProperties":  true
                                                                           }
                                                          }
                                       },
                       "networkPolicy":  {
                                             "type":  "object",
                                             "additionalProperties":  false,
                                             "required":  [
                                                              "enabled",
                                                              "ingressController",
                                                              "postgresql",
                                                              "ingress",
                                                              "egress"
                                                          ],
                                             "properties":  {
                                                                "enabled":  {
                                                                                "type":  "boolean"
                                                                            },
                                                                "ingressController":  {
                                                                                          "type":  "object",
                                                                                          "additionalProperties":  false,
                                                                                          "required":  [
                                                                                                           "enabled",
                                                                                                           "namespace"
                                                                                                       ],
                                                                                          "properties":  {
                                                                                                             "enabled":  {
                                                                                                                             "type":  "boolean"
                                                                                                                         },
                                                                                                             "namespace":  {
                                                                                                                               "type":  "string",
                                                                                                                               "minLength":  1
                                                                                                                           }
                                                                                                         }
                                                                                      },
                                                                "postgresql":  {
                                                                                   "type":  "object",
                                                                                   "additionalProperties":  false,
                                                                                   "required":  [
                                                                                                    "enabled",
                                                                                                    "port",
                                                                                                    "cidrs"
                                                                                                ],
                                                                                   "properties":  {
                                                                                                      "enabled":  {
                                                                                                                      "type":  "boolean"
                                                                                                                  },
                                                                                                      "port":  {
                                                                                                                   "type":  "integer",
                                                                                                                   "minimum":  1,
                                                                                                                   "maximum":  65535
                                                                                                               },
                                                                                                      "cidrs":  {
                                                                                                                    "type":  "array",
                                                                                                                    "items":  {
                                                                                                                                  "type":  "string",
                                                                                                                                  "pattern":  "^.+/[0-9]{1,3}$"
                                                                                                                              }
                                                                                                                }
                                                                                                  }
                                                                               },
                                                                "ingress":  {
                                                                                "type":  "array",
                                                                                "minItems":  1
                                                                            },
                                                                "egress":  {
                                                                               "type":  "array",
                                                                               "minItems":  1
                                                                           }
                                                            }
                                         },
                       "pdb":  {
                                   "type":  "object",
                                   "additionalProperties":  false,
                                   "required":  [
                                                    "enabled"
                                                ],
                                   "properties":  {
                                                      "enabled":  {
                                                                      "type":  "boolean"
                                                                  },
                                                      "minAvailable":  {
                                                                           "type":  [
                                                                                        "integer",
                                                                                        "string"
                                                                                    ]
                                                                       },
                                                      "maxUnavailable":  {
                                                                             "type":  [
                                                                                          "integer",
                                                                                          "string"
                                                                                      ]
                                                                         }
                                                  }
                               },
                       "tests":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "timeoutSeconds",
                                                      "image"
                                                  ],
                                     "properties":  {
                                                        "timeoutSeconds":  {
                                                                               "type":  "integer",
                                                                               "minimum":  1,
                                                                               "maximum":  60
                                                                           },
                                                        "image":  {
                                                                      "type":  "object",
                                                                      "additionalProperties":  false,
                                                                      "required":  [
                                                                                       "repository",
                                                                                       "tag",
                                                                                       "digest",
                                                                                       "pullPolicy"
                                                                                   ],
                                                                      "properties":  {
                                                                                         "repository":  {
                                                                                                            "type":  "string",
                                                                                                            "minLength":  1
                                                                                                        },
                                                                                         "tag":  {
                                                                                                     "type":  "string",
                                                                                                     "minLength":  1
                                                                                                 },
                                                                                         "digest":  {
                                                                                                        "type":  "string",
                                                                                                        "pattern":  "^sha256:[0-9a-f]{64}$"
                                                                                                    },
                                                                                         "pullPolicy":  {
                                                                                                            "enum":  [
                                                                                                                         "Always",
                                                                                                                         "IfNotPresent",
                                                                                                                         "Never"
                                                                                                                     ]
                                                                                                        }
                                                                                     }
                                                                  }
                                                    }
                                 },
                       "extraVolumes":  {
                                            "type":  "array",
                                            "items":  {
                                                          "type":  "object"
                                                      }
                                        },
                       "extraVolumeMounts":  {
                                                 "type":  "array",
                                                 "items":  {
                                                               "type":  "object"
                                                           }
                                             },
                       "migrationJob":  {
                                            "type":  "object",
                                            "additionalProperties":  true
                                        },
                       "tenantwright-common":  {
                                               "type":  "object",
                                               "additionalProperties":  true
                                           }
                   }
}