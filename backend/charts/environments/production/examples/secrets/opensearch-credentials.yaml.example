# Copy to an operator-controlled, ignored file and replace the placeholder.
# Never commit the populated file. Rotate any credential previously pasted into chat.
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-opensearch-credentials
  namespace: tenantwright-telemetry
type: Opaque
stringData:
  username: avnadmin
  password: REPLACE_WITH_ROTATED_OPENSEARCH_PASSWORD
