# Copy to observability-secrets.local.yaml (ignored by Git), replace every
# placeholder through the approved secret manager, and never commit the result.
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-grafana-admin
type: Opaque
stringData:
  admin-user: "<break-glass-admin-user>"
  admin-password: "<break-glass-admin-password>"
---
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-alerting-secrets
type: Opaque
stringData:
  alertmanager-webhook-url: "<alert-routing-webhook-url>"
---
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-observability-heartbeat
type: Opaque
stringData:
  webhook-url: "<external-dead-mans-switch-url>"
---
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-grafana-oidc
type: Opaque
stringData:
  client-id: "<grafana-oidc-client-id>"
  client-secret: "<grafana-oidc-client-secret>"
---
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-grafana-database
type: Opaque
stringData:
  host: "<postgres-host-and-port>"
  name: "<grafana-database-name>"
  user: "<grafana-database-user>"
  password: "<grafana-database-password>"
---
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-grafana-database-ca
type: Opaque
stringData:
  ca.crt: |
    <provider-ca-certificate-pem>
---
apiVersion: v1
kind: Secret
metadata:
  name: tenantwright-prometheus-remote-write
type: Opaque
stringData:
  token: "<remote-write-bearer-token>"
