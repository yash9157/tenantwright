dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1862.severity = none

[services/Notifications/Notifications.Application/Templates/NotificationTemplateAdminAppService.Publishing.cs]
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1862.severity = none

[tests/Shared.EventBus.Tests/MessagingCatalogAndTrustTests.cs]
# DispatchProxy generates a subclass at runtime, so its proxy base types cannot
# be sealed even though no source-declared subclass exists.
dotnet_diagnostic.CA1852.severity = none
