{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": {
    "AutoMigrate": false
  },
  "Cors": {
    "Origins": "http://localhost:4200,https://localhost:4200"
  },
  "ForwardedHeaders": {
    "KnownNetworks": [
      "10.128.0.0/14"
    ]
  },
  "AuthServer": {
    "Authority": "https://localhost:7239/",
    "Audiences": "identity,tenant,permissions,auditlogs,notifications,auth,workflows"
  },
  "GatewayLimits": {
    "MaxRequestBodyBytes": 10485760,
    "RequestTimeoutSeconds": 30,
    "MaxAuthorizationHeaderBytes": 8192,
    "MaxRequestHeadersTotalSize": 32768
  },
  "ReverseProxy": {
    "Routes": {
      "g1": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/g1/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g1" },
          { "PathPrefix": "/api/identity" }
        ]
      },
      "g2": {
        "ClusterId": "tenant",
        "Match": {
          "Path": "/g2/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g2" },
          { "PathPrefix": "/api/tenant" }
        ]
      },
      "g3": {
        "ClusterId": "permissions",
        "Match": {
          "Path": "/g3/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g3" },
          { "PathPrefix": "/api/permissions" }
        ]
      },
      "g4": {
        "ClusterId": "auditlogs",
        "Match": {
          "Path": "/g4/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g4" },
          { "PathPrefix": "/api/audit-logs" }
        ]
      },
      "g5": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/g5/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g5" },
          { "PathPrefix": "/api/notifications" }
        ]
      },
      "notificationsWebhooks": {
        "ClusterId": "notifications",
        "Order": -200,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/g5/webhooks/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g5" },
          { "PathPrefix": "/api/notifications" }
        ]
      },
      "notificationsHub": {
        "ClusterId": "notifications",
        "Order": -100,
        "Match": {
          "Path": "/g5/hubs/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g5" }
        ]
      },
      "g6": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/g6/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g6" },
          { "PathPrefix": "/api" }
        ]
      },
      "g12": {
        "ClusterId": "workflows",
        "Match": {
          "Path": "/g12/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/g12" },
          { "PathPrefix": "/api/workflows" }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity_1": {
            "Address": "http://localhost:5161/"
          }
        }
      },
      "tenant": {
        "Destinations": {
          "tenant_1": {
            "Address": "http://localhost:5162/"
          }
        }
      },
      "permissions": {
        "Destinations": {
          "permissions_1": {
            "Address": "http://localhost:5163/"
          }
        }
      },
      "auditlogs": {
        "Destinations": {
          "auditlogs_1": {
            "Address": "http://localhost:5164/"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "notifications_1": {
            "Address": "http://localhost:5165/"
          }
        }
      },
      "auth": {
        "Destinations": {
          "auth_1": {
            "Address": "http://localhost:5234/"
          }
        }
      },
      "workflows": {
        "Destinations": {
          "workflows_1": {
            "Address": "http://localhost:5166/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
