<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;border-collapse:separate;border-spacing:0;background:#ffffff;border:1px solid #e1e3e4;border-radius:20px;overflow:hidden;box-shadow:0 28px 56px -18px rgba(0,104,94,0.10);">
  <tr>
    <td align="center" style="padding:32px 32px 20px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
        <tr>
          <td align="center" style="width:42px;height:42px;border-radius:12px;background:#00685e;background-image:linear-gradient(135deg,#00685e 0%,#008377 100%);color:#ffffff;font-family:Manrope,Arial,sans-serif;font-size:20px;font-weight:800;">
            +
          </td>
          <td style="padding-left:12px;font-family:Manrope,Arial,sans-serif;font-size:24px;font-weight:800;letter-spacing:-0.02em;color:#00685e;">
            Cura Clinical
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:0 32px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:0;background:#f3f4f5;border-radius:18px;">
        <tr>
          <td align="center" style="padding:36px 16px;">
            <div style="width:96px;height:96px;line-height:96px;border-radius:999px;background:#ffffff;color:#00685e;font-size:38px;font-weight:800;text-align:center;box-shadow:0 18px 36px -18px rgba(0,104,94,0.22);">
              @
            </div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:0 32px 32px;text-align:center;">
      <div style="margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:0.24em;text-transform:uppercase;color:#526069;">
        Clinical activation
      </div>
      <h1 style="margin:0 0 18px;font-family:Manrope,Arial,sans-serif;font-size:32px;line-height:1.1;font-weight:800;letter-spacing:-0.03em;color:#191c1d;">
        Activate Your Clinical Workspace
      </h1>
      <div style="margin:0 auto 28px;max-width:460px;font-size:15px;line-height:1.75;color:#526069;">
        <p style="margin:0 0 12px;">Welcome to Cura Clinical.</p>
        <p style="margin:0;">Your institutional account has been provisioned. Verify your email address to activate the workspace and complete secure sign-in, recovery, and alert delivery.</p>
      </div>
      <div style="margin:0 0 28px;">
        <a href="{{model.link}}" style="display:inline-block;padding:15px 30px;border-radius:12px;background:#00685e;background-image:linear-gradient(135deg,#00685e 0%,#008377 100%);color:#ffffff;text-decoration:none;font-family:Manrope,Arial,sans-serif;font-size:15px;font-weight:700;box-shadow:0 18px 32px -18px rgba(0,104,94,0.35);">
          Activate Account
        </a>
      </div>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:0;background:#f3f4f5;border:1px solid #e1e3e4;border-radius:14px;">
        <tr>
          <td style="padding:16px 18px;text-align:left;">
            <div style="margin:0 0 8px;font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#526069;">
              Direct activation link
            </div>
            <a href="{{model.link}}" style="color:#00685e;word-break:break-all;text-decoration:none;">{{model.link}}</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:24px 32px 30px;border-top:1px solid rgba(188,201,198,0.45);text-align:center;">
      <div style="margin:0 0 10px;color:#ba1a1a;font-size:13px;font-weight:700;">
        This link will expire in 24 hours.
      </div>
      <p style="margin:0 auto;max-width:420px;font-size:12px;line-height:1.7;color:#526069;">
        If you did not expect this account, contact your IT support team immediately. Cura Clinical protects activation workflows with tenant-aware validation and short-lived encrypted tokens.
      </p>
    </td>
  </tr>
</table>
