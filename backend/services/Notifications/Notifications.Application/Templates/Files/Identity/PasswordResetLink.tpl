<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;border-collapse:separate;border-spacing:0;">
  <tr>
    <td style="padding:0 0 20px;">
      <div style="font-family:Manrope,Arial,sans-serif;font-size:24px;font-weight:800;letter-spacing:-0.02em;color:#00685e;">
        Clinical Sanctuary
      </div>
      <div style="margin-top:6px;font-size:11px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#526069;">
        Secure account recovery
      </div>
    </td>
  </tr>
  <tr>
    <td style="background:#ffffff;border:1px solid #e1e3e4;border-radius:18px;overflow:hidden;box-shadow:0 24px 48px -16px rgba(0,104,94,0.08);">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
        <tr>
          <td align="center" style="padding:28px 24px;background:#00685e;background-image:linear-gradient(90deg,#00685e 0%,#008377 100%);">
            <div style="font-family:Manrope,Arial,sans-serif;font-size:24px;font-weight:800;letter-spacing:-0.02em;color:#ffffff;">
              CSH Systems
            </div>
          </td>
        </tr>
        <tr>
          <td style="padding:32px;">
            <div style="width:64px;height:64px;line-height:64px;border-radius:20px;background:#d3e2ed;color:#00685e;font-size:28px;font-weight:800;text-align:center;margin:0 auto 20px;">
              +
            </div>
            <h1 style="margin:0 0 14px;font-family:Manrope,Arial,sans-serif;font-size:30px;line-height:1.1;font-weight:800;letter-spacing:-0.03em;text-align:center;color:#191c1d;">
              Reset your password
            </h1>
            <p style="margin:0 auto 24px;max-width:420px;font-size:15px;line-height:1.7;text-align:center;color:#526069;">
              We received a request to access your Clinical Sanctuary account. Use the secure link below to establish a new password for your institutional profile.
            </p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:0;background:#f3f4f5;border-radius:14px;border:1px solid #e1e3e4;margin:0 0 24px;">
              <tr>
                <td style="padding:16px 18px;">
                  <div style="margin:0 0 6px;font-size:13px;font-weight:700;color:#191c1d;">Did not request this?</div>
                  <div style="font-size:13px;line-height:1.7;color:#526069;">If you did not ask to change your password, you can safely ignore this email and your current credential will remain active.</div>
                </td>
              </tr>
            </table>
            <div style="text-align:center;margin:0 0 24px;">
              <a href="{{model.link}}" style="display:inline-block;padding:15px 28px;border-radius:12px;background:#00685e;color:#ffffff;text-decoration:none;font-family:Manrope,Arial,sans-serif;font-size:15px;font-weight:700;box-shadow:0 18px 32px -18px rgba(0,104,94,0.35);">
                Reset Password
              </a>
            </div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:0;background:#f3f4f5;border:1px solid #e1e3e4;border-radius:12px;">
              <tr>
                <td style="padding:16px 18px;">
                  <div style="margin:0 0 8px;font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#526069;">
                    Direct reset link
                  </div>
                  <a href="{{model.link}}" style="color:#00685e;word-break:break-all;text-decoration:none;">{{model.link}}</a>
                </td>
              </tr>
            </table>
            <p style="margin:24px 0 0;font-size:13px;line-height:1.7;color:#526069;text-align:center;">
              This link expires automatically for your protection and remains active for 60 minutes.
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding:18px 6px 0;text-align:center;font-size:12px;line-height:1.6;color:#6d7a77;">
      Clinical Sanctuary protects recovery requests with short-lived tokens, tenant-aware validation, and encrypted delivery.
    </td>
  </tr>
</table>
