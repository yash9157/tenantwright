{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": {
    "AutoMigrate": false
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Authority": "https://localhost:7239/",
    "Audiences": "notifications"
  },
  "OpenIddict": {
    "Clients": {
      "NotificationsInternal": {
        "ClientId": "tenantwright-notifications-internal",
        "Secret": ""
      }
    }
  },
  "NotificationsInternal": {
    "AllowedClientIds": "auth-internal"
  },
  "SessionValidation": {
    "Enabled": true,
    "Strict": true,
    "MarkerTtlHours": 168
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Shared": {
    "Data": {
      "ConnectionStringResolver": {
        "AllowHostFallbackForTenant": true
      }
    }
  },
  "Caching": {
    "Provider": "Valkey",
    "Valkey": {
      "Configuration": "localhost",
      "InstanceName": "TenantWright_"
    }
  },
  "Permissions": {
    "Enabled": true
  },
  "RemoteFeatureChecker": {
    "Enabled": true,
    "FailOpen": false,
    "BaseAddress": "https://localhost:7163",
    "TimeoutSeconds": 3,
    "Scope": "features.check",
    "ClientId": "auth-internal",
    "ClientSecret": ""
  },
  "IdentityPreferencesClient": {
    "Enabled": true,
    "FailClosed": true,
    "BaseAddress": "https://localhost:7161/",
    "ClientProfile": "NotificationsInternal",
    "Scope": "identity-internal",
    "TimeoutSeconds": 3
  },
  "IdentityAudienceClient": {
    "Enabled": true,
    "BaseAddress": "https://localhost:7161/",
    "ClientProfile": "NotificationsInternal",
    "Scope": "identity-internal",
    "TimeoutSeconds": 5,
    "PageSize": 200
  },
  "Notifications": {
    "Templates": {
      "RootPath": "Templates/Files",
      "Extension": ".tpl",
      "LayoutTemplateName": "Layout"
    },
    "Realtime": {
      "Enabled": true,
      "Valkey": {
        "ChannelPrefix": "TenantWright_Notifications"
      }
    },
    "Presence": {
      "Enabled": true,
      "TtlSeconds": 120
    },
    "Channels": {
      "EmailEnabled": true,
      "AppEnabled": true,
      "SmsEnabled": false,
      "PushEnabled": false,
      "WhatsAppEnabled": false
    },
    "Providers": {
      "Sms": "Disabled",
      "Push": "Disabled",
      "WhatsApp": "Disabled"
    },
    "Delivery": {
      "Enabled": true,
      "PollIntervalMs": 1000,
      "BatchSize": 100,
      "ProcessingLeaseSeconds": 60,
      "MaxRetryCount": 5,
      "BaseRetryDelaySeconds": 15,
      "MaxRetryDelaySeconds": 300,
      "OwnershipAcquireTimeoutMs": 100,
      "OwnershipLeaseMs": 5000,
      "EnableSignalDrivenWorker": true,
      "WakeupMode": "ValkeyPubSub",
      "WakeupValkeyChannel": "tenantwright:notifications:delivery:wakeup",
      "IdleSafetyPollMs": 30000,
      "MaxScheduleHorizonDays": 365
    },
    "DeliveryLatencyRollup": {
      "Enabled": true,
      "LookbackHours": 48,
      "MaxBucketsPerRun": 24,
      "IntervalSeconds": 300
    },
    "ProviderSecrets": {
      "Protection": {
        "CurrentKeyId": "notifications-provider-secrets-v1",
        "CurrentKeyVersion": 1,
        "RequireProtectedValues": false,
        "Keys": {}
      },
      "Rotation": {
        "Enabled": false,
        "IntervalSeconds": 300,
        "BatchSize": 100
      }
    },
    "Digests": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "BatchSize": 100
    },
    "Retention": {
      "Enabled": true,
      "IntervalSeconds": 3600,
      "HotRetentionDays": 365,
      "PresenceRetentionDays": 90,
      "BatchSize": 500
    },
    "RateLimit": {
      "Enabled": false,
      "WindowSeconds": 60,
      "PerTenantChannelPerWindow": 600,
      "BurstAllowance": 0,
      "GlobalPerWindow": 20000,
      "PerChannelOverrides": {}
    },
    "Sms": {
      "Provider": "Twilio",
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": "",
      "WebhookBaseUrl": ""
    },
    "Audience": {
      "Enabled": true,
      "MaxResolvedRecipients": 5000
    },
    "Query": {
      "IncludeRecipientValue": false,
      "IncludeLastError": false
    },
    "Email": {
      "Smtp": {
        "Host": "",
        "Port": 587,
        "UserName": "",
        "Password": "",
        "FromAddress": "",
        "FromName": "",
        "SecureSocketOption": "StartTls"
      }
    }
  },
  "AuditLogging": {
    "IsEnabled": true,
    "HideErrors": true,
    "ApplicationName": "notifications-service",
    "IsEnabledForAnonymousUsers": true,
    "AlwaysLogOnException": true,
    "IsEnabledForIntegrationServices": false,
    "IsEnabledForGetRequests": false,
    "DisableLogActionInfo": false,
    "SaveEntityHistoryWhenNavigationChanges": true,
    "IgnoredUrls": [
      "/health",
      "/metrics",
      "/connect/token",
      "/connect/authorize",
      "/connect/logout",
      "/connect/revoke"
    ],
    "RequireExplicitControllerAuditing": false,
    "RequireExplicitServiceAuditing": false,
    "WriteRequestAuditOnlyForAuditedEndpoints": true,
    "EnforcementMode": "Observe"
  },
  "Messaging": {
    "Provider": "None",
    "ServiceName": "tenantwright-notifications",
    "ProducerPrincipal": "tenantwright-notifications"
  },
  "NotificationsPublishing": {
    "SourceService": "notifications-service"
  }
}
