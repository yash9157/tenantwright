{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": {
    "AutoMigrate": false
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Authority": "https://localhost:7239/",
    "Audiences": "auditlogs"
  },
  "SessionValidation": {
    "Enabled": true,
    "Strict": true,
    "MarkerTtlHours": 168
  },
  "Shared": {
    "Data": {
      "ConnectionStringResolver": {
        "AllowHostFallbackForTenant": true
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "BackgroundTasks": {
    "Hangfire": {
      "Enabled": true,
      "ServiceName": "auditlogs",
      "ConnectionStringName": "Default",
      "SchemaName": "hangfire_auditlogs",
      "PrepareSchemaIfNecessary": true,
      "Queues": [
        "auditlogs-critical",
        "auditlogs-default",
        "auditlogs-low",
        "auditlogs-recurring"
      ],
      "WorkerCount": 5,
      "Dashboard": {
        "Enabled": false,
        "Path": "/internal/hangfire",
        "AllowedRoles": [],
        "AllowedClientIds": []
      }
    }
  },
  "Caching": {
    "Provider": "Valkey",
    "Valkey": {
      "Configuration": "localhost",
      "InstanceName": "TenantWright_"
    }
  },
  "Permissions": {
    "Enabled": true
  },
  "RemoteFeatureChecker": {
    "Enabled": true,
    "FailOpen": false,
    "BaseAddress": "https://localhost:7163",
    "TimeoutSeconds": 3,
    "Scope": "features.check",
    "ClientId": "auth-internal",
    "ClientSecret": ""
  },
  "AuditLogging": {
    "IsEnabled": true,
    "HideErrors": true,
    "ApplicationName": "auditlogs-service",
    "IsEnabledForAnonymousUsers": true,
    "AlwaysLogOnException": true,
    "IsEnabledForIntegrationServices": false,
    "IsEnabledForGetRequests": false,
    "DisableLogActionInfo": false,
    "SaveEntityHistoryWhenNavigationChanges": true,
    "IgnoredUrls": [
      "/health",
      "/metrics",
      "/connect/token",
      "/connect/authorize",
      "/connect/logout",
      "/connect/revoke"
    ],
    "RequireExplicitControllerAuditing": false,
    "RequireExplicitServiceAuditing": false,
    "WriteRequestAuditOnlyForAuditedEndpoints": true,
    "EnforcementMode": "Observe",
    "StrictFailureCategories": [],
    "Security": {
      "SendExceptionDetailsToClients": false,
      "SendExceptionStackTraceToClients": false,
      "SendExceptionTypeToClients": false,
      "HiddenExceptionMessage": "Exception details are hidden."
    },
    "Redaction": {
      "Mask": "***REDACTED***",
      "SensitiveKeys": [
        "password",
        "secret",
        "token",
        "access_token",
        "refresh_token",
        "authorization",
        "cookie",
        "api_key",
        "apikey",
        "creditcard",
        "ssn",
        "nationalid",
        "otp"
      ]
    },
    "Archive": {
      "Enabled": true,
      "HotRetentionDays": 365,
      "BlobRetentionYears": 10,
      "PartitionUnit": "Month",
      "MaxPartitionsPerCycle": 3,
      "RowBatchSize": 500,
      "DeleteBatchSize": 2000,
      "RecurringCron": "0 * * * *",
      "DeleteArchivedFromHotStore": false,
      "AllowRestore": true,
      "MaxRestoreRowsPerRun": 50000,
      "MaxConcurrentRestorePartitions": 1,
      "Blob": {
        "Provider": "FileSystem",
        "ContainerName": "auditlogs-archive",
        "CreateContainerIfNotExists": true,
        "FileSystem": {
          "BasePath": "",
          "AppendContainerNameToBasePath": true,
          "RetryCount": 3
        },
        "Azure": {
          "ConnectionString": "",
          "ContainerName": ""
        },
        "Aws": {
          "Region": "",
          "AccessKeyId": "",
          "SecretAccessKey": "",
          "ContainerName": ""
        }
      }
    },
    "Sealing": {
      "Enabled": true,
      "WatermarkLagSeconds": 120,
      "MaxBatchSize": 5000,
      "IntervalSeconds": 60
    },
    "OperationalHealth": {
      "TimeoutSeconds": 5,
      "HangfireHeartbeatGraceSeconds": 120,
      "MaximumEligibleSealLagRows": 10000,
      "BlobCanaryPrefix": "_health/"
    },
    "Signatures": {
      "CurrentKeyId": "",
      "Keys": {},
      "RequireSignatures": false,
      "FreshnessTolerance": "00:05:00"
    }
  },
  "Messaging": {
    "Provider": "None",
    "ServiceName": "tenantwright-auditlogs",
    "ProducerPrincipal": "tenantwright-auditlogs"
  },
  "NotificationsPublishing": {
    "SourceService": "auditlogs-service"
  }
}
