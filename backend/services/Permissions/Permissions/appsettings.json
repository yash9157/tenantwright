{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": {
    "AutoMigrate": false
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Authority": "https://localhost:7239/",
    "Audiences": "permissions"
  },
  "SessionValidation": {
    "Enabled": true,
    "Strict": true,
    "MarkerTtlHours": 168
  },
  "ConnectionStrings": {
    "Default": ""

  },
  "BackgroundTasks": {
    "Hangfire": {
      "Enabled": true,
      "ServiceName": "permissions",
      "ConnectionStringName": "Default",
      "SchemaName": "hangfire_permissions",
      "Queues": [
        "permissions-critical",
        "permissions-default",
        "permissions-low",
        "permissions-recurring"
      ],
      "WorkerCount": 3,
      "Dashboard": {
        "Enabled": false,
        "Path": "/internal/hangfire",
        "AllowedRoles": [],
        "AllowedClientIds": []
      }
    }
  },
  "PermissionCacheRefresh": {
    "Enabled": true,
    "RecurringCron": "*/30 * * * *",
    "Queue": "permissions-recurring"
  },
  "Shared": {
    "Data": {
      "ConnectionStringResolver": {
        "AllowHostFallbackForTenant": true
      }
    }
  },
  "Caching": {
    "Provider": "Valkey",
    "Valkey": {
      "Configuration": "localhost",
      "InstanceName": "TenantWright_"
    }
  },
  "Permissions": {
    "Enabled": true,
    "GrantSweep": {
      "Enabled": true,
      "IntervalSeconds": 300,
      "BatchSize": 500
    }
  },
  "PermissionsInternal": {
    "CapabilityMetadata": {
      "AllowedClientIds": ""
    },
    "EntitlementProvisioning": {
      "AllowedClientIds": ""
    },
    "SubjectPermissionAuthorization": {
      "Enabled": false,
      "AllowedClientIds": ""
    }
  },
  "RemoteFeatureChecker": {
    "Enabled": false,
    "FailOpen": false,
    "BaseAddress": "https://localhost:7163",
    "TimeoutSeconds": 3,
    "Scope": "features.check",
    "ClientId": "auth-internal",
    "ClientSecret": ""
  },
  "IdentityPermissionTargetValidation": {
    "BaseAddress": "https://localhost:7161/",
    "Scope": "identity-internal",
    "ClientId": "auth-internal",
    "ClientSecret": "",
    "TimeoutSeconds": 3
  },
  "AuditLogging": {
    "IsEnabled": true,
    "HideErrors": true,
    "ApplicationName": "permissions-service",
    "IsEnabledForAnonymousUsers": true,
    "AlwaysLogOnException": true,
    "IsEnabledForIntegrationServices": false,
    "IsEnabledForGetRequests": false,
    "DisableLogActionInfo": false,
    "SaveEntityHistoryWhenNavigationChanges": true,
    "IgnoredUrls": [
      "/health",
      "/metrics",
      "/connect/token",
      "/connect/authorize",
      "/connect/logout",
      "/connect/revoke"
    ],
    "RequireExplicitControllerAuditing": false,
    "RequireExplicitServiceAuditing": false,
    "WriteRequestAuditOnlyForAuditedEndpoints": true,
    "EnforcementMode": "Observe",
    "StrictFailureCategories": [ "permissions.grant" ]
  },
  "Messaging": {
    "Provider": "None",
    "ServiceName": "tenantwright-permissions",
    "ProducerPrincipal": "tenantwright-permissions"
  },
  "NotificationsPublishing": {
    "SourceService": "permissions-service"
  }
}
