{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [ { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } } ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": { "AutoMigrate": false },
  "AllowedHosts": "*",
  "AuthServer": {
    "Authority": "https://localhost:7239/",
    "Audiences": "workflows"
  },
  "SessionValidation": {
    "Enabled": true,
    "Strict": true,
    "MarkerTtlHours": 168
  },
  "Shared": {
    "Data": {
      "ConnectionStringResolver": {
        "AllowHostFallbackForTenant": true
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Caching": {
    "Provider": "Valkey",
    "Valkey": { "Configuration": "localhost", "InstanceName": "TenantWright_" }
  },
  "Permissions": { "Enabled": true },
  "RemoteFeatureChecker": {
    "Enabled": true,
    "FailOpen": false,
    "BaseAddress": "https://localhost:7163",
    "TimeoutSeconds": 3,
    "Scope": "features.check",
    "ClientId": "auth-internal",
    "ClientSecret": ""
  },
  "Temporal": {
    "Enabled": false,
    "TargetHost": "localhost:7233",
    "Namespace": "tenantwright-development",
    "WorkflowTaskQueue": "tenantwright-workflows-orchestration-v1",
    "ActivityTaskQueue": "tenantwright-workflows-activities-v1",
    "UseTls": false,
    "TlsDomain": "",
    "ServerRootCaCertificatePath": "",
    "ClientCertificatePath": "",
    "ClientPrivateKeyPath": "",
    "ApiKeyPath": "",
    "MaxConcurrentWorkflowTasks": 100,
    "MaxConcurrentActivities": 100,
    "GracefulShutdownTimeout": "00:00:30"
  },
  "Messaging": {
    "Provider": "None",
    "ServiceName": "tenantwright-workflows",
    "ProducerPrincipal": "tenantwright-workflows"
  },
  "NotificationsPublishing": { "SourceService": "workflows-service" }
}
