{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": {
    "AutoMigrate": false
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Authority": "https://localhost:7239/",
    "Audiences": "tenant"
  },
  "SessionValidation": {
    "Enabled": true,
    "Strict": true,
    "MarkerTtlHours": 168
  },
  "Shared": {
    "Data": {
      "ConnectionStringResolver": {
        "AllowHostFallbackForTenant": true
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Caching": {
    "Provider": "Valkey",
    "Valkey": {
      "Configuration": "localhost",
      "InstanceName": "TenantWright_"
    }
  },
  "TenantCache": {
    "MaxAbsoluteExpirationHours": 720
  },
  "PublicTenantRegistrationCleanup": {
    "Enabled": false,
    "ExpiryHours": 72,
    "BatchSize": 50
  },
  "BootstrapSeed": {
    "Enabled": false,
    "DefaultTenant": {
      "Enabled": true,
      "Id": "11111111-1111-1111-1111-111111111111",
      "Name": "default"
    }
  },
  "Permissions": {
    "Enabled": true
  },
  "TenantInternal": {
    "Serviceability": {
      "AllowedClientIds": ""
    }
  },
  "RemoteFeatureChecker": {
    "Enabled": true,
    "FailOpen": false,
    "BaseAddress": "https://localhost:7163",
    "TimeoutSeconds": 3,
    "Scope": "features.check",
    "ClientId": "auth-internal",
    "ClientSecret": ""
  },
  "TenantImpactEnrichment": {
    "IdentityBaseAddress": "https://localhost:7161/",
    "NotificationsBaseAddress": "https://localhost:7165/",
    "ClientProfile": "Internal",
    "TimeoutMilliseconds": 1500
  },
  "AuditLogging": {
    "IsEnabled": true,
    "HideErrors": true,
    "ApplicationName": "tenant-service",
    "IsEnabledForAnonymousUsers": true,
    "AlwaysLogOnException": true,
    "IsEnabledForIntegrationServices": false,
    "IsEnabledForGetRequests": false,
    "DisableLogActionInfo": false,
    "SaveEntityHistoryWhenNavigationChanges": true,
    "IgnoredUrls": [
      "/health",
      "/metrics",
      "/connect/token",
      "/connect/authorize",
      "/connect/logout",
      "/connect/revoke"
    ],
    "RequireExplicitControllerAuditing": false,
    "RequireExplicitServiceAuditing": false,
    "WriteRequestAuditOnlyForAuditedEndpoints": true,
    "EnforcementMode": "Observe",
    "StrictFailureCategories": [ "tenant.lifecycle" ]
  },
  "Messaging": {
    "Provider": "None",
    "ServiceName": "tenantwright-tenant",
    "ProducerPrincipal": "tenantwright-tenant"
  },
  "NotificationsPublishing": {
    "SourceService": "tenant-service"
  }
}
