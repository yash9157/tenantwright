{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": {
    "AutoMigrate": false
  },
  "AllowedHosts": "*",
  "AuthServer": {
    "Authority": "https://localhost:7239/",
    "Audiences": "IdentityService"
  },
  "Identity": {
    "Lockout": {
      "AllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    }
  },
  "SessionValidation": {
    "Enabled": true,
    "Strict": true,
    "MarkerTtlHours": 168
  },
  "RoleMembershipPolicy": {
    "MaxActiveRoleMemberships": 32
  },
  "LoginRisk": {
    "Enabled": true,
    "Mode": "Observe",
    "LowThreshold": 40,
    "HighThreshold": 70,
    "NewDeviceWeight": 25,
    "NewIpWeight": 20,
    "GeoShiftWeight": 0,
    "GeoSignalTrusted": false,
    "FailureBurstWeight": 25,
    "FailureBurstWindow": "00:15:00",
    "FailureBurstThreshold": 3,
    "HistoryWindow": "30.00:00:00",
    "TrustedDeviceDays": 30,
    "HeaderCountryCodeName": "X-Country-Code",
    "Alerting": {
      "Enabled": true,
      "TemplateName": "security-risk-blocked-login",
      "Subject": "High-risk login blocked",
      "Recipients": []
    }
  },
  "Passkeys": {
    "Enabled": true,
    "RelyingPartyId": "localhost",
    "RelyingPartyName": "TenantWright",
    "Origins": [
      "https://localhost:7239"
    ],
    "CeremonyTtlSeconds": 300
  },
  "PasswordReset": {
    "Enabled": true,
    "TokenTtlMinutes": 15,
    "TemplateName": "Identity.PasswordResetLink",
    "RequestLimitPerWindow": 5,
    "RequestLimitWindowSeconds": 300,
    "AllowedBaseUrls": [
      "https://localhost:7239"
    ]
  },
  "EmailVerification": {
    "Enabled": true,
    "TemplateName": "Identity.EmailVerificationLink",
    "AllowedBaseUrls": [
      "https://localhost:7239"
    ]
  },
  "PublicInvitationManagement": {
    "Enabled": true,
    "TokenTtlHours": 168,
    "TemplateName": "Identity.PublicInvitationLink",
    "Subject": "You have been invited to join your organization",
    "AllowedBaseUrls": [
      "https://localhost:7239"
    ]
  },
  "InteractiveLogin": {
    "ChallengeTtlSeconds": 300
  },
  "LoginAttemptProtection": {
    "Enabled": true,
    "RequestLimitPerWindow": 15,
    "RequestLimitWindowSeconds": 300
  },
  "IdentityInternal": {
    "AllowedClientIds": "auth-internal,tenantwright-notifications-internal"
  },
  "IdentityRateLimiting": {
    "Login": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Mfa": {
      "PermitLimit": 90,
      "WindowSeconds": 60
    },
    "Reset": {
      "PermitLimit": 60,
      "WindowSeconds": 300
    }
  },
  "Shared": {
    "Data": {
      "ConnectionStringResolver": {
        "AllowHostFallbackForTenant": true
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "BackgroundTasks": {
    "Hangfire": {
      "Enabled": true,
      "ServiceName": "identity",
      "ConnectionStringName": "Default",
      "SchemaName": "hangfire_identity",
      "Queues": [
        "identity-critical",
        "identity-default",
        "identity-low",
        "identity-recurring"
      ],
      "WorkerCount": 5,
      "Dashboard": {
        "Enabled": false,
        "Path": "/internal/hangfire",
        "AllowedRoles": [],
        "AllowedClientIds": []
      }
    }
  },
  "Caching": {
    "Provider": "Valkey",
    "Valkey": {
      "Configuration": "localhost",
      "InstanceName": "TenantWright_"
    }
  },
  "BootstrapSeed": {
    "Enabled": false,
    "HostAdmin": {
      "Enabled": true,
      "TenantId": "00000000-0000-0000-0000-000000000000",
      "UserName": "",
      "Email": "",
      "Password": ""
    },
    "TenantAdmin": {
      "Enabled": false,
      "TenantId": "00000000-0000-0000-0000-000000000000",
      "TenantName": "",
      "UserName": "",
      "Email": "",
      "Password": "",
      "ResetPasswordOnSeed": false
    }
  },
  "Permissions": {
    "Enabled": true
  },
  "RemoteFeatureChecker": {
    "Enabled": true,
    "FailOpen": false,
    "BaseAddress": "https://localhost:7163",
    "TimeoutSeconds": 3,
    "Scope": "features.check",
    "ClientId": "auth-internal",
    "ClientSecret": ""
  },
  "AuditLogging": {
    "IsEnabled": true,
    "HideErrors": true,
    "ApplicationName": "identity-service",
    "IsEnabledForAnonymousUsers": true,
    "AlwaysLogOnException": true,
    "IsEnabledForIntegrationServices": false,
    "IsEnabledForGetRequests": false,
    "DisableLogActionInfo": false,
    "SaveEntityHistoryWhenNavigationChanges": true,
    "IgnoredUrls": [
      "/health",
      "/metrics",
      "/connect/token",
      "/connect/authorize",
      "/connect/logout",
      "/connect/revoke"
    ],
    "RequireExplicitControllerAuditing": false,
    "RequireExplicitServiceAuditing": false,
    "WriteRequestAuditOnlyForAuditedEndpoints": true,
    "EnforcementMode": "Observe",
    "StrictFailureCategories": [ "auth.session" ]
  },
  "Messaging": {
    "Provider": "None",
    "ServiceName": "tenantwright-identity",
    "ProducerPrincipal": "tenantwright-identity"
  },
  "NotificationsPublishing": {
    "SourceService": "identity-service"
  }
}
