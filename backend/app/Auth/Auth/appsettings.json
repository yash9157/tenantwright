{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EfCore": {
    "AutoMigrate": false
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownNetworks": [
      "10.128.0.0/14"
    ]
  },
  "Services": {
    "Identity": {
      "Url": "https://localhost:7161"
    },
    "Tenant": {
      "Url": "https://localhost:7162"
    }
  },
  "AuthServer": {
    "Authority": "https://localhost:7239/"
  },
  "Security": {
    "Csp": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com;"
  },
  "Cors": {
    "Origins": "http://localhost:4200,https://localhost:4200"
  },
  "OpenIddict": {
    "Issuer": "https://localhost:7239/",
    "Clients": {
      "Internal": {
        "ClientId": "auth-internal",
        "DisplayName": "Auth Internal Client",
        "Secret": ""
      },
      "TenantWrightGateway": {
        "ClientId": "tenantwright-gateway",
        "DisplayName": "TenantWright Gateway Client",
        "RedirectUri": "https://localhost:4200/auth/callback",
        "RedirectUris": [
          "http://localhost:4200/auth/callback",
          "https://localhost:4200/auth/callback"
        ],
        "PostLogoutRedirectUri": "https://localhost:4200/auth/logout-callback",
        "PostLogoutRedirectUris": [
          "http://localhost:4200/auth/logout-callback",
          "https://localhost:4200/auth/logout-callback"
        ]
      },
      "NotificationsInternal": {
        "ClientId": "tenantwright-notifications-internal",
        "DisplayName": "TenantWright Notifications Internal Client",
        "Secret": ""
      }
    },
    "SigningCertificate": {
      "Path": "certs/auth-signing.pfx",
      "Password": ""
    },
    "EncryptionCertificate": {
      "Path": "certs/auth-encryption.pfx",
      "Password": ""
    }
  },
  "Shared": {
    "Data": {
      "ConnectionStringResolver": {
        "AllowHostFallbackForTenant": true
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Caching": {
    "Provider": "Valkey",
    "Valkey": {
      "Configuration": "localhost",
      "InstanceName": "TenantWright_"
    }
  },
  "Permissions": {
    "Enabled": true
  },
  "RemoteFeatureChecker": {
    "Enabled": false,
    "FailOpen": false,
    "BaseAddress": "https://localhost:7163",
    "TimeoutSeconds": 3,
    "Scope": "features.check",
    "ClientId": "auth-internal",
    "ClientSecret": ""
  },
  "IdentityUserCache": {
    "ProfileSoftTtlMinutes": 120,
    "ProfileHardTtlMinutes": 1440,
    "AliasSoftTtlMinutes": 360,
    "AliasHardTtlMinutes": 1440,
    "AuthzHardTtlUpperBoundMinutes": 15,
    "AuthzSoftTtlMinMinutes": 2,
    "AuthzSoftTtlMaxMinutes": 5,
    "LockTtlSeconds": 3,
    "StrictRefreshWaitMilliseconds": 300,
    "JitterPercent": 10
  },
  "OpenIddictCache": {
    "ApplicationTtlMinutes": 1440,
    "ScopeTtlMinutes": 1440
  },
  "TokenSecurity": {
    "MaxSerializedAccessTokenBytes": 6144,
    "MaxActiveRoleMemberships": 32
  },
  "Auth": {
    "PublicBaseUrl": "https://localhost:7239",
    "PublicTenantRegistration": {
      "Enabled": false,
      "TurnstileSiteKey": "",
      "TurnstileSecret": "",
      "ExpectedHostName": "",
      "HashKey": "",
      "CleanupHours": 72,
      "IpHourlyLimit": 3,
      "EmailHourlyLimit": 2,
      "TenantDailyLimit": 2,
      "BlockedDomains": []
    },
    "Quartz": {
      "UsePersistentStore": true,
      "AutoCreateSchema": true,
      "PerformSchemaValidation": true
    },
    "RateLimiting": {
      "Login": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "Mfa": {
        "PermitLimit": 12,
        "WindowSeconds": 60
      },
      "Reset": {
        "PermitLimit": 8,
        "WindowSeconds": 300
      },
      "Token": {
        "PermitLimit": 500,
        "WindowSeconds": 60,
        "QueueLimit": 0,
        "PartitionMode": "ClientIp"
      }
    },
    "TokenMetadataCache": {
      "Enabled": true,
      "KeyPrefix": "Auth:TokenMetadata",
      "ScopeResourceL1Seconds": 60,
      "ScopeResourceL2Minutes": 30,
      "ScopeSetL1Seconds": 60,
      "ScopeSetL2Minutes": 30,
      "ClientL1Seconds": 60,
      "ClientL2Minutes": 30,
      "StampCacheMinutes": 1440
    }
  },
  "SessionValidation": {
    "Enabled": true,
    "Strict": true,
    "MarkerTtlHours": 168,
    "EnableDbFallbackOnValkeyMiss": false
  },
  "AuditLogging": {
    "IsEnabled": true,
    "HideErrors": true,
    "ApplicationName": "auth-service",
    "IsEnabledForAnonymousUsers": true,
    "AlwaysLogOnException": true,
    "IsEnabledForIntegrationServices": false,
    "IsEnabledForGetRequests": false,
    "DisableLogActionInfo": false,
    "SaveEntityHistoryWhenNavigationChanges": true,
    "IgnoredUrls": [
      "/health",
      "/metrics",
      "/connect/token",
      "/connect/authorize",
      "/connect/logout",
      "/connect/revoke"
    ],
    "RequireExplicitControllerAuditing": false,
    "RequireExplicitServiceAuditing": false,
    "WriteRequestAuditOnlyForAuditedEndpoints": true,
    "EnforcementMode": "Observe"
  },
  "Messaging": {
    "Provider": "None",
    "ServiceName": "tenantwright-auth",
    "ProducerPrincipal": "tenantwright-auth"
  },
  "NotificationsPublishing": {
    "SourceService": "auth-service"
  }
}
