@page
@using Auth.Pages.Account.Partials
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_AuthShell";
    ViewData["AuthHideBrandPanel"] = true;
    ViewData["AuthMaxWidth"] = "max-w-2xl";
}

<section class="rounded-3xl bg-surface-high p-8 shadow-card ring-1 ring-outline/50 sm:p-10">
    <div class="flex items-center gap-3">
        <span class="flex size-11 items-center justify-center rounded-2xl bg-primary-soft text-primary">
            <span class="material-symbols-outlined text-[24px]">shield_person</span>
        </span>
        <div>
            <h1 class="font-headline text-2xl font-bold tracking-tight text-on-surface">Privacy &amp; data protection</h1>
            <p class="text-sm text-on-surface-soft">@AuthBrand.LegalName</p>
        </div>
    </div>

    <div class="mt-6 space-y-4 text-sm leading-relaxed text-on-surface-soft">
        <p>This authentication portal processes only the data required to verify your identity and protect access to protected systems: your account identifier, credentials, session metadata, and security event logs.</p>
        <p>Authentication events are recorded for security auditing and compliance with applicable data protection regulations. Credentials are never logged in plain text, and sessions are encrypted in transit and at rest.</p>
        <p>For questions about how your data is handled, or to exercise your data rights, contact your organization's data protection officer or IT administrator.</p>
    </div>

    <div class="mt-8">
        <a class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary-container" href="@AuthPageRoutes.SignIn">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to sign in</span>
        </a>
    </div>
</section>
