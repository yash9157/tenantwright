@page "/Account/PasswordChangedSuccess"
@using Auth.Pages.Account.Partials
@model Auth.Pages.Account.PasswordChangedSuccessModel
@{
    ViewData["Title"] = "Password updated";
    Layout = "_AuthShell";
    ViewData["AuthMaxWidth"] = "max-w-md";
}

<section class="auth-card overflow-hidden rounded-card">
    <div class="brand-hairline h-px w-full"></div>
    <div class="relative p-6 sm:p-8 text-center">

        <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "check-circle", Tone = "success", Heading = "Password updated", Description = "Your password has been updated successfully. You can now sign in." })" />

        <div class="mt-6">
            <a class="btn btn-primary group" href="@Model.SignInUrl">
                <span>Continue to sign in</span>
                <span class="transition-transform duration-200 group-hover:translate-x-1">@AuthIcons.Get("arrow-right", "size-[18px]", "2")</span>
            </a>
        </div>
    </div>
</section>
