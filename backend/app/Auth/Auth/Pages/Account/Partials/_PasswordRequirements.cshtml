@using Auth.Pages.Account.Partials
@model int
@{
    var minLength = Model > 0 ? Model : 8;
}
<div class="neu-inset rounded-2xl px-4 py-3.5">
    <p class="text-xs font-semibold uppercase tracking-wider text-on-surface-soft">Password requirements</p>
    <ul class="mt-2.5 space-y-2 text-sm text-on-surface-soft">
        <li class="flex items-center gap-2.5">
            <span class="flex size-5 items-center justify-center rounded-full bg-surface-strong text-on-surface-soft">
                @AuthIcons.Get("check", "size-3", "2.5")
            </span>
            At least @minLength characters
        </li>
        <li class="flex items-center gap-2.5">
            <span class="flex size-5 items-center justify-center rounded-full bg-surface-strong text-on-surface-soft">
                @AuthIcons.Get("check", "size-3", "2.5")
            </span>
            Both passwords match
        </li>
    </ul>
</div>
