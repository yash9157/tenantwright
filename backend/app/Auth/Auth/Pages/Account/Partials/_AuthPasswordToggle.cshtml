@using Auth.Pages.Account.Partials
@* Show/hide password button. Must be placed inside an element with
   x-data="authPasswordField"; it binds to that scope's toggle/visible/concealed/toggleLabel. *@
<button class="auth-toggle" type="button" x-on:click="toggle" x-bind:aria-label="toggleLabel">
    <span x-show="concealed">@AuthIcons.Get("eye")</span>
    <span x-show="visible" x-cloak>@AuthIcons.Get("eye-off")</span>
</button>
