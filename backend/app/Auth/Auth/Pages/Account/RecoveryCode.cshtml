@page "/Account/Login/RecoveryCode"
@using Auth.Pages.Account.Partials
@model Auth.Pages.Account.RecoveryCodeModel
@{
    ViewData["Title"] = "Use a recovery code";
    Layout = "_AuthShell";
    ViewData["AuthMaxWidth"] = "max-w-md";
}

@if (!Model.HasChallengeContext)
{
    <section class="auth-card overflow-hidden rounded-card">
        <div class="brand-hairline h-px w-full"></div>
        <div class="relative p-6 sm:p-8 text-center">
            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "info", Tone = "warning", Heading = "Session expired", Description = "Your verification session is no longer valid. Sign in again to request a new code." })" />
            <div class="mt-6">
                <a class="btn btn-primary" href="@AuthPageRoutes.SignIn">Back to sign in</a>
            </div>
        </div>
    </section>
}
else
{
    <section class="auth-card overflow-hidden rounded-card">
        <div class="brand-hairline h-px w-full"></div>
        <div class="relative p-6 sm:p-8">

            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "key", Heading = "Use a recovery code", Description = "Enter one of your single-use recovery codes to sign in." })" />

            <form method="post" action="@AuthPageRoutes.RecoveryCode" asp-antiforgery="true" data-auth-form="true" novalidate class="mt-6 space-y-4">
                <partial name="Partials/_AuthAlert" model="@(new AuthAlertModel { Message = Model.ErrorMessage ?? string.Empty })" />
                <partial name="Partials/_AuthValidationSummary" />

                <div data-auth-field="true">
                    <label asp-for="Input.RecoveryCode" class="auth-label">Recovery code</label>
                    <input asp-for="Input.RecoveryCode" class="auth-input text-center font-headline text-lg tracking-[0.2em] placeholder:tracking-normal" style="height:3.5rem;" autocomplete="off" maxlength="19" placeholder="XXXX-XXXX-XXXX-XXXX" data-auth-validate="recovery-code" data-auth-required-message="Recovery code is required." />
                    <span class="auth-helper">Codes are single-use and case sensitive.</span>
                    <span asp-validation-for="Input.RecoveryCode" class="auth-error"></span>
                </div>

                <div class="pt-1">
                    @await Html.PartialAsync("Partials/_AuthActionButton", new AuthActionButtonModel
                    {
                        Text = "Verify",
                        IconSymbol = "arrow_forward",
                        LoadingText = "Verifying…"
                    })
                </div>
            </form>

            @if (Model.AuthenticatorCodeAvailable)
            {
                <div class="mt-6 space-y-3 text-center">
                    <a class="inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary-container" href="@AuthPageRoutes.Mfa">
                        @AuthIcons.Get("arrow-left", "size-4", "2")
                        <span>Use authenticator code instead</span>
                    </a>
                </div>
            }
        </div>
    </section>
}
