@page "/Account/ForgotPassword/Submitted"
@using Auth.Pages.Account.Partials
@model Auth.Pages.Account.ForgotPasswordSubmittedModel
@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthShell";
    ViewData["AuthMaxWidth"] = "max-w-md";
}

<section class="auth-card overflow-hidden rounded-card">
    <div class="brand-hairline h-px w-full"></div>
    <div class="relative p-6 sm:p-8">

        <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "mail", Heading = "Check your email", Description = "If an account matches those details, we've sent a password reset link to your email." })" />

        <div class="mt-5 space-y-3">
            <p class="auth-alert auth-alert--info">
                @AuthIcons.Get("info", "size-5", "2")
                <span>The link expires after 15 minutes.</span>
            </p>
            <p class="text-center text-sm leading-relaxed text-on-surface-soft">
                Didn't receive the email? Check your spam folder or contact your IT administrator.
            </p>
        </div>

        <div class="mt-6 space-y-3">
            <partial name="Partials/_AuthResend" model="@(new AuthResendModel { IdleLabel = "Resend email", Href = AuthPageRoutes.ForgotPassword, Key = "auth.resend.reset", IsPrimary = true })" />
            <a class="btn btn-secondary" href="@AuthPageRoutes.SignIn">Back to sign in</a>
        </div>
    </div>
</section>
