@page "/Account/PasswordExpired"
@using Auth.Pages.Account.Partials
@model Auth.Pages.Account.PasswordExpiredModel
@{
    ViewData["Title"] = "Update your password";
    Layout = "_AuthShell";
    ViewData["AuthMaxWidth"] = "max-w-md";
}

@if (!Model.HasChallengeContext)
{
    <section class="auth-card overflow-hidden rounded-card">
        <div class="brand-hairline h-px w-full"></div>
        <div class="relative p-6 sm:p-8 text-center">
            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "info", Tone = "warning", Heading = "Session expired", Description = "Your session is no longer valid. Sign in again to continue." })" />
            <div class="mt-6">
                <a class="btn btn-primary" href="@AuthPageRoutes.SignIn">Back to sign in</a>
            </div>
        </div>
    </section>
}
else
{
    <section class="auth-card overflow-hidden rounded-card">
        <div class="brand-hairline h-px w-full"></div>
        <div class="relative p-6 sm:p-8">

            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "lock", Heading = "Update your password", Description = "Your password has expired. Create a new one to continue." })" />

            <form method="post" action="@AuthPageRoutes.PasswordExpired" asp-antiforgery="true" data-auth-form="true" data-auth-password-policy='@System.Text.Json.JsonSerializer.Serialize(Model.PasswordPolicy)' novalidate class="mt-6 space-y-4">
                <partial name="Partials/_AuthAlert" model="@(new AuthAlertModel { Message = Model.ErrorMessage ?? string.Empty })" />
                <partial name="Partials/_AuthValidationSummary" />

                <div data-auth-field="true">
                    <label asp-for="Input.CurrentPassword" class="auth-label">Current password</label>
                    <div class="auth-control auth-control--icon" x-data="authPasswordField">
                        <span class="auth-control__icon">@AuthIcons.Get("lock")</span>
                        <input asp-for="Input.CurrentPassword" id="current-password" x-bind:type="passwordType" class="auth-input pr-12" autocomplete="current-password" placeholder="Enter your current password" data-auth-validate="current-password" data-auth-required-message="Password is required." />
                        <partial name="Partials/_AuthPasswordToggle" />
                    </div>
                    <span asp-validation-for="Input.CurrentPassword" class="auth-error"></span>
                </div>

                <div data-auth-field="true">
                    <label asp-for="Input.NewPassword" class="auth-label">New password</label>
                    <div class="auth-control auth-control--icon" x-data="authPasswordField">
                        <span class="auth-control__icon">@AuthIcons.Get("lock")</span>
                        <input asp-for="Input.NewPassword" id="expired-new-password" x-bind:type="passwordType" class="auth-input pr-12" autocomplete="new-password" placeholder="Enter a new password" data-auth-validate="new-password" data-auth-revalidate-target="#expired-confirm-password" data-auth-required-message="Password is required." />
                        <partial name="Partials/_AuthPasswordToggle" />
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="auth-error"></span>
                </div>

                <div data-auth-field="true">
                    <label asp-for="Input.ConfirmPassword" class="auth-label">Confirm new password</label>
                    <div class="auth-control auth-control--icon" x-data="authPasswordField">
                        <span class="auth-control__icon">@AuthIcons.Get("lock")</span>
                        <input asp-for="Input.ConfirmPassword" id="expired-confirm-password" x-bind:type="passwordType" class="auth-input pr-12" autocomplete="new-password" placeholder="Re-enter your new password" data-auth-validate="confirm-password" data-auth-password-match="#expired-new-password" data-auth-required-message="Confirm your new password." />
                        <partial name="Partials/_AuthPasswordToggle" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="auth-error"></span>
                </div>

                <partial name="Partials/_PasswordRequirements" model="@Model.PasswordPolicy.RequiredLength" />

                <div class="pt-1">
                    @await Html.PartialAsync("Partials/_AuthActionButton", new AuthActionButtonModel
                    {
                        Text = "Update password",
                        IconSymbol = "arrow_forward",
                        LoadingText = "Updating password…"
                    })
                </div>
            </form>

            <partial name="Partials/_AuthBack" model="@("Back to sign in")" />
        </div>
    </section>
}
