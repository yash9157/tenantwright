@page "/Account/Login/Mfa"
@using Auth.Pages.Account.Partials
@model Auth.Pages.Account.MfaModel
@{
    ViewData["Title"] = "Enter verification code";
    Layout = "_AuthShell";
    ViewData["AuthMaxWidth"] = "max-w-md";
}

@if (!Model.HasChallengeContext)
{
    <section class="auth-card overflow-hidden rounded-card">
        <div class="brand-hairline h-px w-full"></div>
        <div class="relative p-6 sm:p-8 text-center">
            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "info", Tone = "warning", Heading = "Session expired", Description = "Your verification session is no longer valid. Sign in again to request a new code." })" />
            <div class="mt-6">
                <a class="btn btn-primary" href="@AuthPageRoutes.SignIn">Back to sign in</a>
            </div>
        </div>
    </section>
}
else
{
    <section class="auth-card overflow-hidden rounded-card">
        <div class="brand-hairline h-px w-full"></div>
        <div class="relative p-6 sm:p-8">

            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "shield-check", Heading = "Enter authenticator code", Description = "Enter the 6-digit code from the authenticator app configured for this account." })" />

            <form method="post" action="@AuthPageRoutes.Mfa" asp-antiforgery="true" data-auth-form="true" novalidate class="mt-6 space-y-5">
                <partial name="Partials/_AuthAlert" model="@(new AuthAlertModel { Message = Model.ErrorMessage ?? string.Empty })" />
                <partial name="Partials/_AuthValidationSummary" />

                <div data-auth-field="true">
                    <div class="flex items-center justify-center gap-2 sm:gap-3" id="mfa-otp-group" role="group" aria-label="6-digit verification code" data-auth-otp="true" data-auth-otp-target="mfa-code-input">
                        @for (var i = 0; i < 6; i++)
                        {
                            if (i == 3)
                            {
                                <div class="h-0.5 w-2.5 shrink-0 rounded-full bg-outline-strong/50"></div>
                            }
                            <input class="otp-slot" data-auth-otp-slot="true" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit @(i + 1)" />
                        }
                    </div>
                    <input asp-for="Input.TwoFactorCode" id="mfa-code-input" type="hidden" autocomplete="one-time-code" data-auth-validate="otp" data-auth-focus-target="#mfa-otp-group input[data-auth-otp-slot='true']" />
                    <span asp-validation-for="Input.TwoFactorCode" class="mt-3 block text-center text-sm font-medium text-danger"></span>
                </div>

                <input asp-for="Input.RecoveryCode" type="hidden" />

                <div class="space-y-3">
                    @await Html.PartialAsync("Partials/_AuthActionButton", new AuthActionButtonModel
                    {
                        Text = "Verify",
                        IconSymbol = "arrow_forward",
                        LoadingText = "Verifying…"
                    })
                    @if (Model.RecoveryCodeAvailable)
                    {
                        <a class="btn btn-secondary" href="@AuthPageRoutes.RecoveryCode">Use a recovery code</a>
                    }
                </div>
            </form>

            <partial name="Partials/_AuthBack" model="@("Back to sign in")" />
        </div>
    </section>
}
