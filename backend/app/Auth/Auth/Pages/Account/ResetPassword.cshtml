@page "/Account/ResetPassword"
@using Auth.Pages.Account.Partials
@model Auth.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Create a new password";
    Layout = "_AuthShell";
    ViewData["AuthMaxWidth"] = "max-w-md";
}

<section class="auth-card overflow-hidden rounded-card">
    <div class="brand-hairline h-px w-full"></div>
    <div class="relative p-6 sm:p-8">

        <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "lock", Heading = "Create a new password", Description = "Choose a secure password for your account." })" />

        <form method="post" action="@AuthPageRoutes.ResetPassword" asp-antiforgery="true" data-auth-form="true" data-auth-password-policy='@System.Text.Json.JsonSerializer.Serialize(Model.PasswordPolicy)' novalidate class="mt-6 space-y-4">
            <partial name="Partials/_AuthAlert" model="@(new AuthAlertModel { Message = Model.ErrorMessage ?? string.Empty })" />
            <partial name="Partials/_AuthValidationSummary" />

            <input type="hidden" asp-for="Input.TenantId" autocomplete="off" />
            <input type="hidden" asp-for="Input.UserId" autocomplete="off" />
            <input type="hidden" asp-for="Input.Token" autocomplete="off" />

            <div data-auth-field="true">
                <label asp-for="Input.NewPassword" class="auth-label">New password</label>
                <div class="auth-control auth-control--icon" x-data="authPasswordField">
                    <span class="auth-control__icon">@AuthIcons.Get("lock")</span>
                    <input asp-for="Input.NewPassword" id="new-password" x-bind:type="passwordType" class="auth-input pr-12" autocomplete="new-password" placeholder="Enter a new password" data-auth-validate="new-password" data-auth-revalidate-target="#confirm-new-password" data-auth-required-message="Password is required." />
                        <partial name="Partials/_AuthPasswordToggle" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="auth-error"></span>
            </div>

            <div data-auth-field="true">
                <label asp-for="Input.ConfirmPassword" class="auth-label">Confirm new password</label>
                <div class="auth-control auth-control--icon" x-data="authPasswordField">
                    <span class="auth-control__icon">@AuthIcons.Get("lock")</span>
                    <input asp-for="Input.ConfirmPassword" id="confirm-new-password" x-bind:type="passwordType" class="auth-input pr-12" autocomplete="new-password" placeholder="Re-enter your new password" data-auth-validate="confirm-password" data-auth-password-match="#new-password" data-auth-required-message="Confirm your new password." />
                        <partial name="Partials/_AuthPasswordToggle" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="auth-error"></span>
            </div>

            <partial name="Partials/_PasswordRequirements" model="@Model.PasswordPolicy.RequiredLength" />

            <div class="pt-1">
                @await Html.PartialAsync("Partials/_AuthActionButton", new AuthActionButtonModel
                {
                    Text = "Update password",
                    IconSymbol = "arrow_forward",
                    LoadingText = "Updating password…"
                })
            </div>
        </form>

        <partial name="Partials/_AuthBack" model="@("Back to sign in")" />
    </div>
</section>
