@page "/Account/ResetPassword/Result"
@using Auth.Pages.Account.Partials
@model Auth.Pages.Account.ResetPasswordResultModel
@{
    ViewData["Title"] = Model.IsSuccess ? "Password updated" : "Reset link invalid";
    Layout = "_AuthShell";
    ViewData["AuthMaxWidth"] = "max-w-md";
}

<section class="auth-card overflow-hidden rounded-card">
    <div class="brand-hairline h-px w-full"></div>
    <div class="relative p-6 sm:p-8 text-center">
        @if (Model.IsSuccess)
        {
            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "check-circle", Tone = "success", Heading = "Password updated", Description = "Your password has been updated successfully. You can now sign in." })" />
            <div class="mt-6">
                <a class="btn btn-primary group" href="@AuthPageRoutes.SignIn">
                    <span>Continue to sign in</span>
                    <span class="transition-transform duration-200 group-hover:translate-x-1">@AuthIcons.Get("arrow-right", "size-[18px]", "2")</span>
                </a>
            </div>
        }
        else
        {
            <partial name="Partials/_AuthHeader" model="@(new AuthHeaderModel { Icon = "alert-circle", Tone = "danger", Heading = "Reset link invalid", Description = "This reset link is invalid or has expired. Request a new link to continue." })" />
            <div class="mt-6 space-y-3">
                <a class="btn btn-primary" href="@AuthPageRoutes.ForgotPassword">Request a new link</a>
                <a class="btn btn-secondary" href="@AuthPageRoutes.SignIn">Back to sign in</a>
            </div>
        }
    </div>
</section>
